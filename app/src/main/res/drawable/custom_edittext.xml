<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Background Color -->
    <solid android:color="#FFFFFF"/>

    <!-- Rounded Corners -->
    <corners android:radius="25dp"/>

    <!-- Border -->
    <stroke
        android:width="2dp"
        android:color="#6200EE"/>

    <!-- Padding Inside -->
    <padding
        android:left="16dp"
        android:right="16dp"
        android:top="12dp"
        android:bottom="12dp"/>
</shape>